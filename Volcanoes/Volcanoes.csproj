<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Configurations>Debug;Release;Linux</Configurations>
    <TargetFramework Condition="'$(Configuration)'=='Linux'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(Configuration)'!='Linux'">net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Volcano</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <NoWarn>$(NoWarn);CA1416;WFO1000</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Linux'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0-windows'">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>icon.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="icon.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.21.9" />
    <PackageReference Condition="'$(TargetFramework)'=='net10.0-windows'" Include="libtorch-cuda-12.8-win-x64" Version="2.10.0" />

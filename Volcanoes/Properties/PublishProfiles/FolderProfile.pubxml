<?xml version="1.0" encoding="utf-8"?>
<!-- https://go.microsoft.com/fwlink/?LinkID=208121. -->
<Project>
  <PropertyGroup>
    <Configuration>Publish</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Publish\net10.0-windows\publish\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
  <Target Name="RestorePublishConfiguration" BeforeTargets="ResolvePackageAssets" Condition="'$(Configuration)'=='Publish'">
    <Exec Command="dotnet restore &quot;$(MSBuildProjectFullPath)&quot; -p:Configuration=Publish --force" />
  </Target>
  <Target Name="ClearStalePublishOutput" BeforeTargets="Publish" Condition="'$(Configuration)'=='Publish'">
    <RemoveDir Directories="$(PublishDir)" />
  </Target>
</Project>